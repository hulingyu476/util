-
+ 		if(!isExistUsb(volumeName)){
+	              for (String folderName : sDefaultFolderNames) {
+	                    final File folder = new File(vol.getDirectory(), folderName);
+	                    if (!folder.exists()) {
+	                        folder.mkdirs();
+	                        insertDirectory(db, folder.getAbsolutePath());
+	                    }
+	                }
+		 }
