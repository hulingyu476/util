@@ -792,7 +792,22 @@ public class MediaProvider extends ContentProvider {
         }
         return false;
     }
-
+	//add by yangT 2020-9-26
+     private String usbRoodPath = "/mnt/media_rw";
+	private boolean isExistUsb(String dirName) {
+		if (dirName.length() >= 9 && dirName.contains("-")) {
+			String startChar = dirName.substring(0, dirName.indexOf("-"));
+		        String endChar = dirName.substring(dirName.indexOf("-") + 1);
+		        Log.i(TAG, "yangT...startChar=" + startChar + ";;;endChar=" + endChar);
+		        if (null != startChar && null != endChar&& startChar.length() == 4 && endChar.length() == 4) {
+						return true;
+			}
+		}
+
+			Log.w(TAG, "yangT...no usb");
+			return false;
+		}
+		//add end
     /**
      * Ensure that default folders are created on mounted primary storage
      * devices. We only do this once per volume so we don't annoy the user if
@@ -817,14 +832,16 @@ public class MediaProvider extends ContentProvider {
             final SharedPreferences prefs = PreferenceManager
                     .getDefaultSharedPreferences(getContext());
             if (prefs.getInt(key, 0) == 0) {
-                for (String folderName : sDefaultFolderNames) {
-                    final File folder = new File(vol.getDirectory(), folderName);
-                    if (!folder.exists()) {
-                        folder.mkdirs();
-                        insertDirectory(db, folder.getAbsolutePath());
